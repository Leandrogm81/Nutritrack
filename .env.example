# OpenRouter API key — server-side only.
# Do not use the VITE_ prefix for secrets.
OPENROUTER_API_KEY="sk-or-..."

# Optional model override exposed to the client bundle.
# This is not a secret.
VITE_OPENROUTER_MODEL="xiaomi/mimo-v2.5"

# Optional proxy timeout override in milliseconds.
# Keep below the Vercel function maxDuration.
OPENROUTER_PROXY_TIMEOUT_MS="55000"
